# Copy this file to .env and edit values before running docker compose / up.ps1.
#
# HERMES_WORKSPACE is the HOST folder bind-mounted into the agent at /opt/data
# (config, .env, memories/, skills/, sessions/, cron/). Use FORWARD slashes on
# Windows (Docker dislikes backslashes).  Example: HERMES_WORKSPACE=D:/hermes-shared-data
HERMES_WORKSPACE=./workspace
TZ=America/New_York

# --- Models -----------------------------------------------------------------
# Local Qwen model tag as known by Ollama. Pulled into the ollama container on
# first run (up.ps1 does this) or manually:
#   docker exec -it ollama-qwen ollama pull batiai/qwen3.6-27b:q3
QWEN_MODEL=batiai/qwen3.6-27b:q3
# Qwen context window (tokens) = the real VRAM/KV-cache knob. It sets Ollama's
# server default (OLLAMA_CONTEXT_LENGTH). Larger = more VRAM; keep it small (8192)
# on a 20GB GPU. NOTE: hermes/config.yaml separately declares model.context_length
# (65536) to satisfy Hermes' 64K-minimum check -- that's metadata only, no VRAM.
QWEN_NUM_CTX=8192
# Claude model the claude-adapter drives via Claude Code (your Max subscription).
CLAUDE_MODEL=claude-opus-4-8
# Claude Code tool permissions on the claude lane (headless `claude -p` cannot
# show permission prompts). true = --dangerously-skip-permissions: ALL tools,
# including Bash, no prompts. false = only the CLAUDE_ALLOWED_TOOLS allowlist
# (file tools scoped to /opt/data + web; no Bash) -- safer against prompt
# injection from fetched job postings, since this container holds the token.
CLAUDE_BYPASS_PERMISSIONS=true
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Write,Edit,WebFetch,WebSearch
# Per-turn budget (seconds) for a Claude Code run; tool-using pipeline turns
# (fetch a page -> read files -> draft) need more than a text-only reply.
CLAUDE_TIMEOUT=600

# --- Where Ollama runs --------------------------------------------------------
# gpu   = the ollama container with an NVIDIA GPU (Windows + Docker Desktop WSL 2,
#         or Linux with the NVIDIA Container Toolkit). Default.
# empty = no ollama container. Run Ollama natively on the host (macOS, or Linux
#         without an NVIDIA GPU) and point OLLAMA_URL at it. Docker Compose reads
#         COMPOSE_PROFILES from this file, so every compose command sees it.
COMPOSE_PROFILES=gpu
# Ollama endpoint as seen from INSIDE the containers. Leave the default for the
# container; use http://host.docker.internal:11434 for a host-native Ollama.
OLLAMA_URL=http://ollama:11434

# Which physical NVIDIA GPU to dedicate to Ollama (container mode only). Use the index from
# `nvidia-smi`, OR a GPU UUID from `nvidia-smi -L` for deterministic selection
# (Docker's index order can differ from nvidia-smi's). Examples:
#   OLLAMA_GPU_ID=1
#   OLLAMA_GPU_ID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Inside the container the dedicated GPU is always renumbered to index 0.
OLLAMA_GPU_ID=1

# --- Signal -----------------------------------------------------------------
# The bot's own Signal number (international format, e.g. +14155550123). This is
# the account you link with:  docker compose run --rm signal-cli link.sh
SIGNAL_ACCOUNT=
# Comma-separated phone numbers allowed to talk to the agent. STRONGLY recommended
# (empty falls back to pairing codes). Example: SIGNAL_ALLOWED_USERS=+14155550123
SIGNAL_ALLOWED_USERS=
# Optional: comma-separated allowed group IDs, or * for all groups.
SIGNAL_GROUP_ALLOWED_USERS=
# Where the agent delivers proactive / scheduled (cron) messages. Defaults to the
# bot account itself (Note to Self) if left blank.
SIGNAL_HOME_CHANNEL=

# --- Hermes dashboard (optional) --------------------------------------------
# up.ps1 configures auth + enables it; it binds to localhost (http://localhost:9119).
# Leave HERMES_DASHBOARD_PASSWORD blank to have up.ps1 generate one and print it.
HERMES_DASHBOARD=0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
